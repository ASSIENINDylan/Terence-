# Variables d'environnement du serveur (§12 : aucun secret dans le code).
# Copier en .env pour un lancement local hors docker compose.

HTTP_ADDR=:8080
DATABASE_URL=postgres://mmorpg:mmorpg@localhost:5432/mmorpg?sslmode=disable
REDIS_URL=redis://localhost:6379/0
TICK_HZ=12
STARTUP_TIMEOUT=30s
# Durée de vie d'un token de session dans Redis (T1).
SESSION_TTL=24h
