{
  "name": "shadow-of-the-warrior",
  "version": "2.0.0",
  "description": "Jeu d'aventure et de combat au tour par tour, dessiné au canvas.",
  "main": "main.js",
  "author": "Terence",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win zip",
    "dist:win-installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.terence.shadowofthewarrior",
    "productName": "Shadow of the Warrior",
    "files": [
      "main.js",
      "index.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "ShadowOfTheWarrior-${version}-win64.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ShadowOfTheWarrior-${version}-Setup.${ext}"
    }
  }
}
