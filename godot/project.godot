; Engine configuration file.
; Godot 4.3+  —  RPG 3D « Val-des-Brumes »
; Documentation : https://docs.godotengine.org/en/stable/tutorials/editor/project_settings.html

config_version=5

[application]

config/name="Val-des-Brumes"
config/description="RPG 3D : explorez un village, parlez aux habitants et affrontez les monstres au tour par tour (façon Monster Hunter Stories)."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

; Bus de signaux global (découplage entre systèmes)
SignalBus="*res://scripts/autoload/SignalBus.gd"
; État de la partie + transitions de scènes
GameManager="*res://scripts/autoload/GameManager.gd"
; Base de données des dialogues
DialogueDatabase="*res://scripts/autoload/DialogueDatabase.gd"
; Base de données des monstres / alliés
MonsterDatabase="*res://scripts/autoload/MonsterDatabase.gd"
; Orchestrateur du combat tour par tour
BattleManager="*res://scripts/autoload/BattleManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

